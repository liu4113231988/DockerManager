<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DockerManager</AssemblyName>
    <RootNamespace>DockerManager.Wpf</RootNamespace>
    <ApplicationIcon Condition="Exists('Resources\DockerManager.ico')">Resources\DockerManager.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tmds.Ssh" Version="0.26.0" />
    <PackageReference Include="KubernetesClient" Version="21.0.8" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
</Project>
