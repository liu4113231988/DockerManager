<Window x:Class="DockerManager.Wpf.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 密码" Width="460" Height="280" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F8FAFC">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="MessageText" Grid.Row="0" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <TextBlock Grid.Row="1" Text="密码" Margin="0,0,0,5"/>
    <PasswordBox x:Name="PasswordBox" Grid.Row="2" Margin="0,0,0,12"/>
    <CheckBox x:Name="RememberBox" Grid.Row="3" Content="记住密码（用 Windows 当前用户加密保存在本机，认证失败时自动清除）" Margin="0,0,0,10"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Width="90" Click="Cancel_Click"/>
      <Button Content="连接" Width="100" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
